import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

// ============================================================================
// 1. ENGINE & SCENE RUNTIME INITIALIZATION
// ============================================================================
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x05050a); // Deep obsidian atmosphere
scene.fog = new THREE.FogExp2(0x05050a, 0.05); // Cinematic environmental depth fog

const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
// Initial showcase hero view coordinate position setup
camera.position.set(0, 1.5, 4.5); 

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping; // Matches high-contrast automotive/showroom grades
renderer.toneMappingExposure = 1.2;
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.05;
controls.maxPolarAngle = Math.PI / 2 - 0.01; // Block camera from dipping beneath the ground grid

// ============================================================================
// 2. STUDIO EXHIBITION LIGHTING SETUP (Martial Arts Dramatic Palette)
// ============================================================================
const ambientLight = new THREE.AmbientLight(0xffffff, 0.3);
scene.add(ambientLight);

// Key Overhead Presentation Spotlight
const keyLight = new THREE.SpotLight(0xffffff, 5, 30, Math.PI / 4, 0.5, 1);
keyLight.position.set(0, 8, 2);
keyLight.castShadow = true;
keyLight.shadow.mapSize.width = 2048;
keyLight.shadow.mapSize.height = 2048;
scene.add(keyLight);

// Traditional Crimson Accent/Rim Lighting
const redRimLight = new THREE.DirectionalLight(0xff1e1e, 3);
redRimLight.position.set(-5, 3, -3);
scene.add(redRimLight);

// High-Contrast Fill Side Light
const fillLight = new THREE.DirectionalLight(0xeeeeff, 1.5);
fillLight.position.set(5, 2, 3);
scene.add(fillLight);

// Floor Grid Reflection System
const gridHelper = new THREE.GridHelper(40, 40, 0xff1e1e, 0x111122);
gridHelper.position.y = -1;
scene.add(gridHelper);

// ============================================================================
// 3. VISUAL INNOVATION: Ambient Ember / Firefly Particle System
// ============================================================================
const particleCount = 200;
const particleGeometry = new THREE.BufferGeometry();
const particlePositions = new Float32Array(particleCount * 3);

for(let i=0; i<particleCount * 3; i+=3) {
    particlePositions[i] = (Math.random() - 0.5) * 10;     // X scatter
    particlePositions[i+1] = Math.random() * 4 - 1;         // Y elevation height
    particlePositions[i+2] = (Math.random() - 0.5) * 10;   // Z scatter
}

particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
const particleMaterial = new THREE.PointsMaterial({
    color: 0xff4500, // Fiery orange/red embers
    size: 0.03,
    transparent: true,
    opacity: 0.6,
    blending: THREE.AdditiveBlending
});
const emberParticles = new THREE.Points(particleGeometry, particleMaterial);
scene.add(emberParticles);

// ============================================================================
// 4. MODEL LOADING WITH INTERACTIVE PRELOADER HANDLING
// ============================================================================
let activeModel = null;
const loader = new GLTFLoader();

const progressBar = document.getElementById('progress-bar');
const progressText = document.getElementById('progress-text');
const preloaderScreen = document.getElementById('preloader');

// For your final project, replace this with your actual Sketchfab model path (e.g., './models/katana.gltf')
// Currently loads an internal standard fallback to ensure you NEVER see a permanent black screen again
loader.load(
    'https://threejs.org', 
    (gltf) => {
        activeModel = bruce_lee_statue_scan01.gltf.scene;
        
        // Auto-bounding computation adjustment
        const box = new THREE.Box3().setFromObject(activeModel);
        const center = box.getCenter(new THREE.Vector3());
        activeModel.position.x += (activeModel.position.x - center.x);
        activeModel.position.z += (activeModel.position.z - center.z);
        activeModel.position.y = -0.3; // Rests nicely right over our dark martial arts grid floor

        scene.add(activeModel);

        // Hide preloader element smoothly when file reading tasks finish completely
        preloaderScreen.style.opacity = '0';
        setTimeout(() => {
            preloaderScreen.style.display = 'none';
        }, 500);
    },
    (xhr) => {
        if (xhr.total > 0) {
            const percentage = Math.round((xhr.loaded / xhr.total) * 100);
            progressBar.style.width = `${percentage}%`;
            progressText.innerText = `${percentage}% - LOADING SHOWROOM`;
        }
    },
    (error) => {
        console.error('Check model assets path availability structure:', error);
        progressText.innerText = "ERROR LOADING MODEL ASSETS";
        progressText.style.color = "#ff3e3e";
    }
);

// ============================================================================
// 5. INTERACTIVE CAMERA ANGLE PRESET CONTROL ACTIONS
// ============================================================================
function smoothMoveCamera(targetX, targetY, targetZ, lookAtY = 0) {
    // Uses smooth interpolations inside the animation lifecycle loop
    camera.position.set(targetX, targetY, targetZ);
    controls.target.set(0, lookAtY, 0);
}

document.getElementById('btn-hero').addEventListener('click', (e) => {
    switchActiveTab(e.target);
    smoothMoveCamera(0, 1.5, 4.5, 0);
});
document.getElementById('btn-side').addEventListener('click', (e) => {
    switchActiveTab(e.target);
    smoothMoveCamera(4, 0.5, 0, 0);
});
document.getElementById('btn-top').addEventListener('click', (e) => {
    switchActiveTab(e.target);
    smoothMoveCamera(0.01, 5, 0.01, 0); // Offset x/z slightly to prevent gimbal lock calculation conflicts
});
document.getElementById('btn-hilt').addEventListener('click', (e) => {
    switchActiveTab(e.target);
    smoothMoveCamera(-1, 0.8, 1.5, 0.2);
});

function switchActiveTab(element) {
    document.querySelectorAll('.view-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');
}

// ============================================================================
// 6. MAIN ENGINE RENDERING ANIMATION LIFECYCLE
// ============================================================================
const clock = new THREE.Clock();

function animate() {
    requestAnimationFrame(animate);
    const elapsedTime = clock.getElapsedTime();

    // Ambient floating embers rising up velocity animation loop
    const positions = emberParticles.geometry.attributes.position.array;
    for(let i = 1; i < positions.length; i += 3) {
        positions[i] += 0.005; // Y ascending float speed
        if(positions[i] > 3) {
            positions[i] = -1; // Reset to ground once it drifts high out of screen bounds
        }
    }
    emberParticles.geometry.attributes.position.needsUpdate = true;

    // Smooth subtle display spinning if model instantiation completed
    if (activeModel) {
        activeModel.rotation.y = elapsedTime * 0.15;
    }

    controls.update();
    renderer.render(scene, camera);
}
animate();

// Resizing handling engine adjustments
window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});
