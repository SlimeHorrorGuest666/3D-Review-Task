// ============================================================================
// 7. ENGINE RENDERING TICK LOOP LIFECYCLE
// ============================================================================
const loopClock = new THREE.Clock();
function tick() {
requestAnimationFrame(animate); // Keep structural cycle clean
}
function animate() {
requestAnimationFrame(animate);
const deltaElapsedTime = loopClock.getElapsedTime();
// Constant particle vector update loop transformation
const positionsArray = dojoEmberSystem.geometry.attributes.position.array;
for(let i = 1; i < positionsArray.length; i += 3) {
positionsArray[i] += 0.007; // Rising ascending factor vector speed
if(positionsArray[i] > 4.5) {
positionsArray[i] = -1.5; // Loop reset vector below target dojo mesh grid lines
}
}
dojoEmberSystem.geometry.attributes.position.needsUpdate = true;
// Fluid subtle ambient character rotation sweep
if (targetFighterMesh) {
targetFighterMesh.rotation.y = deltaElapsedTime * 0.14;
}
controls.update();
renderer.render(scene, camera);
}
animate();
// Monitor screen transformations layout resizing vectors
window.addEventListener('resize', () => {
camera.aspect = window.innerWidth / window.innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(window.innerWidth, window.innerHeight);
});
