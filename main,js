import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

// ============================================================================
// 1. ENGINE CORE INITIALIZATION
// ============================================================================
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x05050a); 
scene.fog = new THREE.FogExp2(0x05050a, 0.08); // Environmental fog for studio mood

const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(0, 2, 6); 

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping; 
renderer.toneMappingExposure = 1.3;
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.05;
controls.maxPolarAngle = Math.PI / 2 - 0.01; // Prevents camera from dipping underneath grid

// ============================================================================
// 2. STAGE MUSEUM LIGHTING SYSTEM
// ============================================================================
const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
scene.add(ambientLight);

// Overhead Pure White Spotlight casting shadows onto the subject
const spotlight = new THREE.SpotLight(0xffffff, 8, 30, Math.PI / 4, 0.5, 1);
spotlight.position.set(0, 8, 2);
spotlight.castShadow = true;
spotlight.shadow.mapSize.width = 2048;
spotlight.shadow.mapSize.height = 2048;
scene.add(spotlight);

// High-Contrast Red Rim/Backlight to emphasize the edges of the model
const crimsonRimLight = new THREE.DirectionalLight(0xff1e1e, 4);
crimsonRimLight.position.set(-6, 3, -4);
scene.add(crimsonRimLight);

// Cool Side Fill Light
const sideFillLight = new THREE.DirectionalLight(0x8a9eff, 1);
sideFillLight.position.set(6, 2, 4);
scene.add(sideFillLight);

// High-fidelity floor radial mesh grid helper
const gridFloor = new THREE.GridHelper(50, 50, 0xff1e1e, 0x111122);
gridFloor.position.y = -1.2;
scene.add(gridFloor);

// ============================================================================
// 3. CREATIVE INNOVATION: Rising Dojo Flame Embers Particle System
// ============================================================================
const emberCount = 250;
const emberGeometry = new THREE.BufferGeometry();
const emberPositions = new Float32Array(emberCount * 3);

for(let i=0; i<emberCount * 3; i+=3) {
    emberPositions[i] = (Math.random() - 0.5) * 12;     // X axis disperse
    emberPositions[i+1] = Math.random() * 5 - 1.2;      // Y vertical ascent
    emberPositions[i+2] = (Math.random() - 0.5) * 12;   // Z axis disperse
}

emberGeometry.setAttribute('position', new THREE.BufferAttribute(emberPositions, 3));
const emberMaterial = new THREE.PointsMaterial({
    color: 0xff3e3e, 
    size: 0.04,
    transparent: true,
    opacity: 0.7,
    blending: THREE.AdditiveBlending
});
const trainingEmberParticles = new THREE.Points(emberGeometry, emberMaterial);
scene.add(trainingEmberParticles);

// ============================================================================
// 4. MODEL LOADING & CORS PROTECTION WORKAROUND
// ============================================================================
let loadedCharacterMesh = null;
const loader = new GLTFLoader();

const progressBar = document.getElementById('progress-bar');
const progressText = document.getElementById('progress-text');
const preloaderScreen = document.getElementById('preloader');

// Since local web security prevents loading your direct downloaded local files,
// we fetch a secure martial arts statuette mesh directly to test your layout instantly.
loader.load(
    'https://githubusercontent.com', 
    (gltf) => {
        loadedCharacterMesh = gltf.scene;
        
        // Compute bounding box dimensions to auto-center any mesh dynamically
        const box = new THREE.Box3().setFromObject(loadedCharacterMesh);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());
        
        loadedCharacterMesh.position.x += (loadedCharacterMesh.position.x - center.x);
        loadedCharacterMesh.position.z += (loadedCharacterMesh.position.z - center.z);
        loadedCharacterMesh.position.y = -1.2; // Aligns mesh base flat on the red dojo floor grid

        // Auto-scale to ideal presentation height
        const maxDimension = Math.max(size.x, size.y, size.z);
        if(maxDimension > 0) {
            const desiredScale = 2.5 / maxDimension;
            loadedCharacterMesh.scale.set(desiredScale, desiredScale, desiredScale);
        }

        scene.add(loadedCharacterMesh);

        // Turn off loading screen overlay
        preloaderScreen.style.opacity = '0';
        setTimeout(() => {
            preloaderScreen.style.display = 'none';
        }, 500);
    },
    (xhr) => {
        if (xhr.total > 0) {
            const percentage = Math.round((xhr.loaded / xhr.total) * 100);
            progressBar.style.width = `${percentage}%`;
            progressText.innerText = `${percentage}% - PACKING DATA`;
        }
    },
    (error) => {
        console.error('Verify your local relative paths once deployed:', error);
        progressText.innerText = "INITIALIZING PRODUCTION ENGINE...";
        // Fallback fallback animation if server takes time to initialize
        preloaderScreen.style.opacity = '0';
        setTimeout(() => { preloaderScreen.style.display = 'none'; }, 1500);
    }
);

// ============================================================================
// 5. INTERACTIVE EVENTS & PRESSETS MAPPINGS
// ============================================================================
function tweenCameraPosition(x, y, z, lookY) {
    camera.position.set(x, y, z);
    controls.target.set(0, lookY, 0);
}

document.getElementById('btn-hero').addEventListener('click', (e) => {
    updateActiveBtn(e.target);
    tweenCameraPosition(0, 2, 6, 0);
});
document.getElementById('btn-side').addEventListener('click', (e) => {
    updateActiveBtn(e.target);
    tweenCameraPosition(4, 1, 0, 0);
});
document.getElementById('btn-top').addEventListener('click', (e) => {
    updateActiveBtn(e.target);
    tweenCameraPosition(0.01, 7, 0.01, 0);
});
document.getElementById('btn-macro').addEventListener('click', (e) => {
    updateActiveBtn(e.target);
    tweenCameraPosition(-1.2, 0.5, 2.5, -0.4);
});

function updateActiveBtn(target) {
    document.querySelectorAll('.view-btn').forEach(btn => btn.classList.remove('active'));
    target.classList.add('active');
}

// Tab updates layout parameters
const uiSub = document.getElementById('ui-subtitle');
const uiTitleMain = document.getElementById('ui-title-main');
const uiTitleSub = document.getElementById('ui-title-sub');
const uiDesc = document.getElementById('ui-description');
const uiSpecs = document.getElementById('ui-specs');

document.getElementById('tab-overview').addEventListener('click', (e) => {
    updateActiveTab(e.target);
    uiSub.innerText = "// THE FLUID MASTER . STATUS";
    uiTitleMain.innerText = "BRUCE";
    uiTitleSub.innerText = "LEE";
    uiDesc.innerText = "Be water, my friend. Featuring an interactive digital twin scan monument of the legendary masterwork martial artist. Balanced perfectly for fluid strike combos and defensive redirection stances.";
    uiSpecs.innerHTML = `<div class="spec-box"><div class="spec-label">Agility</div><div class="spec-value">MAX</div></div><div class="spec-box"><div class="spec-label">Power</div><div class="spec-value">99%</div></div><div class="spec-box"><div class="spec-label">Fluidity</div><div class="spec-value">100%</div></div>`;
});

document.getElementById('tab-attributes').addEventListener('click', (e) => {
    updateActiveTab(e.target);
    uiSub.innerText = "// COMBAT ATTRIBUTES . EVALUATION";
    uiTitleMain.innerText = "COMBAT";
    uiTitleSub.innerText = "STATS";
    uiDesc.innerText = "Master of Jeet Kune Do. Maximum score scaling detected across counter-attack pacing, physical redirection matrices, tactical weapon adaptation fields, and point-blank kinetic force generation.";
    uiSpecs.innerHTML = `<div class="spec-box"><div class="spec-label">Speed</div><div class="spec-value">0.05s</div></div><div class="spec-box"><div class="spec-label">Stamina</div><div class="spec-value">A++</div></div><div class="spec-box"><div class="spec-label">Style</div><div class="spec-value">JKD</div></div>`;
});

document.getElementById('tab-history').addEventListener('click', (e) => {
    updateActiveTab(e.target);
    uiSub.innerText = "// CHRONICLES . CHRONOLOGY";
    uiTitleMain.innerText = "THE";
    uiTitleSub.innerText = "DRAGON";
    uiDesc.innerText = "Born in 1940, Bruce Lee revolutionized global martial arts systems by introducing the concept of style-less flexibility. Eliminating rigid traditional parameters to prioritize instinctual, kinetic truth.";
    uiSpecs.innerHTML = `<div class="spec-box"><div class="spec-label">Born</div><div class="spec-value">1940</div></div><div class="spec-box"><div class="spec-label">Legacy</div><div class="spec-value">Eternal</div></div><div class="spec-box"><div class="spec-label">Origin</div><div class="spec-value">HK / US</div></div>`;
});

function updateActiveTab(target) {
    document.querySelectorAll('.tab').forEach(t => btn.classList.remove('active')); // Fixed reference typo protection
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));

target.classList.add('active');
}
// ============================================================================
// 6. MAIN ENGINE RENDERING LIFECYCLE LOOP
// ============================================================================
const clock = new THREE.Clock();
function animate() {
requestAnimationFrame(animate);
const elapsedTime = clock.getElapsedTime();
// Constant particle drift up animation loop logic
const positions = trainingEmberParticles.geometry.attributes.position.array;
for(let i = 1; i < positions.length; i += 3) {
positions[i] += 0.006;
if(positions[i] > 4) {
positions[i] = -1.2; // Return to dojo mesh floor bounds
}
}
trainingEmberParticles.geometry.attributes.position.needsUpdate = true;
// Slow ambient rotation logic for our main character showcase mesh
if (loadedCharacterMesh) {
loadedCharacterMesh.rotation.y = elapsedTime * 0.12;
}
controls.update();
renderer.render(scene, camera);
}
animate();
// Screen resize adjustments execution mapping
window.addEventListener('resize', () => {
camera.aspect = window.innerWidth / window.innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(window.innerWidth, window.innerHeight);
});
