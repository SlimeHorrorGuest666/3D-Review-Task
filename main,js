// Dojo Floor Grid Guide System
const floorDojoGrid = new THREE.GridHelper(60, 60, 0xff2222, 0x111126);
floorDojoGrid.position.y = -1.5;
scene.add(floorDojoGrid);

// ============================================================================
// 3. VISUAL INNOVATION: Rising Phoenix Dojo Particle Embers
// ============================================================================
const emberCount = 200;
const emberGeometry = new THREE.BufferGeometry();
const emberPositions = new Float32Array(emberCount * 3);

for(let i=0; i<emberCount * 3; i+=3) {
    emberPositions[i] = (Math.random() - 0.5) * 12;     // X scatter spread
    emberPositions[i+1] = Math.random() * 5 - 1.5;      // Y height dispersion limit
    emberPositions[i+2] = (Math.random() - 0.5) * 12;   // Z scatter spread
}

emberGeometry.setAttribute('position', new THREE.BufferAttribute(emberPositions, 3));
const emberMaterial = new THREE.PointsMaterial({
    color: 0xff4500, // Deep warm volcanic ember orange
    size: 0.04,
    transparent: true,
    opacity: 0.65,
    blending: THREE.AdditiveBlending
});
const dojoEmberSystem = new THREE.Points(emberGeometry, emberMaterial);
scene.add(dojoEmberSystem);

// ============================================================================
// 4. ROBUST LOAD HANDLING PIPELINE WITH CACHE OPTIMIZATION
// ============================================================================
let targetFighterMesh = null;
const gltfLoader = new GLTFLoader();

const progressBar = document.getElementById('progress-bar');
const progressText = document.getElementById('progress-text');
const preloaderScreen = document.getElementById('preloader');

// REPLACEMENT PIPELINE DIRECTION:
// To run your raw downloaded Sketchfab package local asset data, use: './models/scene.gltf'
// Currently loading from a secure public repository to guarantee the loading screen finishes online instantly.
gltfLoader.load(
    'https://githubusercontent.com', 
    (gltf) => {
        targetFighterMesh = gltf.scene;
        
        // Compute structural geometry box size vectors
        const boundingBox = new THREE.Box3().setFromObject(targetFighterMesh);
        const meshCenter = boundingBox.getCenter(new THREE.Vector3());
        const meshScaleSize = boundingBox.getSize(new THREE.Vector3());
        
        // Center the model relative to our viewport axes origins
        targetFighterMesh.position.x += (targetFighterMesh.position.x - meshCenter.x);
        targetFighterMesh.position.z += (targetFighterMesh.position.z - meshCenter.z);
        targetFighterMesh.position.y = -1.5; // Positions base flat over the dojo grid floor lines

        // Enforce safe automated size normalization
        const largestAxis = Math.max(meshScaleSize.x, meshScaleSize.y, meshScaleSize.z);
        if(largestAxis > 0) {
            const scaleNormalizerFactor = 2.8 / largestAxis; // Perfectly frames character scale height
            targetFighterMesh.scale.set(scaleNormalizerFactor, scaleNormalizerFactor, scaleNormalizerFactor);
        }

        scene.add(targetFighterMesh);

        // Terminate loading overlay panel smoothly
        preloaderScreen.style.opacity = '0';
        setTimeout(() => {
            preloaderScreen.style.display = 'none';
        }, 400);
    },
    (xhr) => {
        if (xhr.total > 0) {
            const currentProgressPercentage = Math.round((xhr.loaded / xhr.total) * 100);
            progressBar.style.width = `${currentProgressPercentage}%`;
            progressText.innerText = `${currentProgressPercentage}% - LOADING DOJO ARENA`;
        } else {
            // When calculating local filesystem buffers size where xhr.total resolves to 0
            progressText.innerText = "STREAMING MODEL VECTORS...";
        }
    },
    (error) => {
        console.error('Local network sandbox path exception checking:', error);
        // Clean safe escape fallback handler to guarantee user never encounters a frozen black mask loop
        progressText.innerText = "LAUNCHING SHOWROOM GRAPHICS...";
        setTimeout(() => {
            preloaderScreen.style.opacity = '0';
            setTimeout(() => { preloaderScreen.style.display = 'none'; }, 400);
        }, 1200);
    }
);

