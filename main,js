import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

// ============================================================================
// 1. ENGINE RUNTIME CONFIGURATION
// ============================================================================
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x05050a); 
scene.fog = new THREE.FogExp2(0x05050a, 0.08); // Depth volumetric atmosphere fog

const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(0, 1.5, 5.5); // Perfect showcase viewport distance placement

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping; 
renderer.toneMappingExposure = 1.25;
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.05;
controls.maxPolarAngle = Math.PI / 2 - 0.01; // Restricts camera from passing under floor grid

// ============================================================================
// 2. EXHIBITION CINEMATIC LIGHTING PALETTE
// ============================================================================
const ambientLight = new THREE.AmbientLight(0xffffff, 0.35);
scene.add(ambientLight);

// High-intensity white top spotlight to cast shadow details on the photogrammetry scan
const overheadSpotlight = new THREE.SpotLight(0xffffff, 8, 35, Math.PI / 4, 0.5, 1);
overheadSpotlight.position.set(0, 9, 3);
overheadSpotlight.castShadow = true;
overheadSpotlight.shadow.mapSize.width = 2048;
overheadSpotlight.shadow.mapSize.height = 2048;
scene.add(overheadSpotlight);

// High-contrast crimson rim backlight to isolate Bruce Lee profile from dark backdrop
const backCrimsonLight = new THREE.DirectionalLight(0xff2222, 4.5);
backCrimsonLight.position.set(-6, 3, -5);
scene.add(backCrimsonLight);

// Balanced cool fill side-light
const fillSideLight = new THREE.DirectionalLight(0x8eb0ff, 1.2);
fillSideLight.position.set(6, 2, 4);
